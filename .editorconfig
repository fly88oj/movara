# EditorConfig: https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.rs]
indent_style = space
indent_size = 4
# rustfmt is authoritative; keep editorconfig aligned with it

[*.{yml,yaml,json,toml}]
indent_style = space
indent_size = 2

[*.md]
# two trailing spaces are a hard line break in markdown
trim_trailing_whitespace = false

[*.sh]
indent_style = space
indent_size = 2
